# ==============================================================================
# SkillManager Environment Variables (.env.example)
# ==============================================================================

# Remote API Tokens (Optional - for higher rate limits on GitHub / HuggingFace)
GITHUB_TOKEN=
HF_TOKEN=

# Host Operating System Detection & Skills Directory Bind Mounts
# Automatically populated by deploy.sh or deploy.ps1 during Docker build
HOST_OS=
HOST_HOME=
HOST_GEMINI_SKILLS_DIR=
HOST_CLAUDE_SKILLS_DIR=
HOST_CODEX_SKILLS_DIR=
HOST_CURSOR_SKILLS_DIR=

